import tkinter as tk
from tkinter import messagebox
from tkinter import font

def obtener_datos():
    try:
        x1 = float(entry_x1.get())
        y1 = float(entry_y1.get())
        x2 = float(entry_x2.get())
        y2 = float(entry_y2.get())

        dx = x1 - x2
        dy = y1 - y2
        x3 = x1 - dy
        y3 = y1 + dx
        x4 = x2 - dy
        y4 = y2 + dx

        messagebox.showinfo("Puntos del cuadrado",
                            f"x3 = {x3:.2f}, y3 = {y3:.2f}\n"
                            f"x4 = {x4:.2f}, y4 = {y4:.2f}")

    except ValueError:
        messagebox.showwarning("Datos inválidos", "Ingrese números válidos")

# Crear ventana
ventana = tk.Tk()
ventana.title("Ingreso de Puntos Base del Fractal")
ventana.geometry("300x300")
mi_fuente = font.Font(family="Comic Sans MS", size=13, weight="bold")

# Etiquetas y campos de entrada
tk.Label(ventana, font=mi_fuente, text="x1:").pack(pady=1)
entry_x1 = tk.Entry(ventana)
entry_x1.pack(pady=1)

tk.Label(ventana, font=mi_fuente, text="y1:").pack(pady=1)
entry_y1 = tk.Entry(ventana)
entry_y1.pack(pady=1)

tk.Label(ventana, font=mi_fuente, text="x2:").pack(pady=1)
entry_x2 = tk.Entry(ventana)
entry_x2.pack(pady=1)

tk.Label(ventana, font=mi_fuente, text="y2:").pack(pady=1)
entry_y2 = tk.Entry(ventana)
entry_y2.pack(pady=1)

tk.Button(ventana, font=('Helvetica', 13, 'bold'),
          text="Enviar", command=obtener_datos).pack(pady=20)

ventana.mainloop()